# CleanArr native package defaults.
# Значения по умолчанию для нативного пакета CleanArr.

DRY_RUN=true
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=15
DB_PATH=/var/lib/cleanarr/cleanarr.db
CONFIG_STATE_PATH=/var/lib/cleanarr/runtime-config.json
UI_LANGUAGE=en
JELLYFIN_LANGUAGE=en

# Authentication is configured from the web UI after first start.
# Авторизация настраивается через web-интерфейс после первого запуска.
# SSO_MODE=password_only
# SSO_ENABLED=false
# SSO_ISSUER_URL=https://auth.example/application/o/cleanarr/
# SSO_CLIENT_ID=cleanarr
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://cleanarr.example/api/auth/sso/callback
# SSO_SCOPES=openid profile email
