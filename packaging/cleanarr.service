[Unit]
Description=CleanArr media cleanup service
Documentation=https://github.com/mambastick/Cleanarr
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cleanarr
Group=cleanarr
WorkingDirectory=/var/lib/cleanarr
EnvironmentFile=-/etc/cleanarr/cleanarr.env
ExecStart=/usr/bin/cleanarr --host 0.0.0.0 --port 8089
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

StateDirectory=cleanarr
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
