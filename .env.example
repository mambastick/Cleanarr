# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://cleanarr.example/api/auth/sso/callback
# SSO_ALLOWED_USERS=admin@example.com
# SSO_ALLOWED_GROUPS=cleanarr-admins
# SSO_GROUP_CLAIM=groups
# SSO_REQUIRED_CLAIM=
# SSO_REQUIRED_VALUE=
# SESSION_COOKIE_SECURE=true
