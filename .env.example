LOG_LEVEL=INFO
DRY_RUN=true
WEBHOOK_SHARED_TOKEN=change-me
HTTP_TIMEOUT_SECONDS=15
CONFIG_STATE_PATH=/config/runtime-config.json

# OIDC access fails closed until an explicit allow-policy is configured.
# SSO_MODE=both
# SSO_ISSUER_URL=https://auth.example/application/o/cleanarr/
